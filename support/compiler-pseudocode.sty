%% ---------------------------------------------------------------
%% compiler-pseudocode.sty
%% Pseudocode, math notation, CFG and IR helpers for a compiler book.
%%
%% Builds on: algorithm + algpseudocode (algorithmicx), amsmath, listings,
%% TikZ.  Works with pdfLaTeX, XeLaTeX and LuaLaTeX.
%%
%% Options (algorithm float style):
%%   ruled (default) | boxed | plain
%%
%% Pseudocode
%%   \begin{algorithm}
%%     \caption{Iterative dataflow}\label{alg:dataflow}
%%     \begin{pseudocode}
%%       \Require CFG $G$, transfer functions $f_B$
%%       \Ensure fixed point $\In{B}$, $\Out{B}$
%%       \State $W \gets$ all blocks
%%       \While{$W \neq \emptyset$}
%%         \State remove $B$ from $W$
%%         ...
%%       \EndWhile
%%     \end{pseudocode}
%%   \end{algorithm}
%%   Extra statements: \Break, \Continue, and \Comment{...}.
%%
%% Math: \In \Out \Gen \Kill \LiveIn \LiveOut \Tf \meet \join
%%       \phifn \assignphi \Pred \Succ \dom \idom \DF \Def \Use
%%       \Entry \Exit \set{..|..}
%%
%% IR listings: \begin{irlisting} ... \end{irlisting}
%% CFG figures: TikZ styles `basic block', `cfg edge', `back edge'
%% ---------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{compiler-pseudocode}[2026/10/15 v1.0 Compiler pseudocode helpers]

% ---------- Options ----------
\DeclareOption{ruled}{\PassOptionsToPackage{ruled}{algorithm}}
\DeclareOption{boxed}{\PassOptionsToPackage{boxed}{algorithm}}
\DeclareOption{plain}{\PassOptionsToPackage{plain}{algorithm}}
\ExecuteOptions{ruled}
\ProcessOptions\relax

% ---------- Dependencies ----------
\RequirePackage{amsmath}
\RequirePackage{amssymb}
% Semantic evaluation brackets (llbracket/rrbracket); standard TeX Live package.
\RequirePackage{stmaryrd}
\RequirePackage{xcolor}
\RequirePackage{algorithm}
\RequirePackage{algpseudocode}
\RequirePackage{listings}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,shapes.geometric,fit}

% ---------- Algorithm float ----------
\floatname{algorithm}{Algorithm}

% ---------- Pseudocode appearance ----------
% Keywords in bold sans-serif, line numbers small and sans-serif.
\newcommand{\cc@kw}[1]{\textsf{\bfseries #1}}

\def\algorithmicend{\cc@kw{end}}
\def\algorithmicdo{\cc@kw{do}}
\def\algorithmicwhile{\cc@kw{while}}
\def\algorithmicfor{\cc@kw{for}}
\def\algorithmicforall{\cc@kw{for each}}
\def\algorithmicloop{\cc@kw{loop}}
\def\algorithmicrepeat{\cc@kw{repeat}}
\def\algorithmicuntil{\cc@kw{until}}
\def\algorithmicprocedure{\cc@kw{procedure}}
\def\algorithmicfunction{\cc@kw{function}}
\def\algorithmicif{\cc@kw{if}}
\def\algorithmicthen{\cc@kw{then}}
\def\algorithmicelse{\cc@kw{else}}
\def\algorithmicrequire{\cc@kw{Input:}}
\def\algorithmicensure{\cc@kw{Output:}}
\def\algorithmicreturn{\cc@kw{return}}

\algrenewcommand\alglinenumber[1]{\footnotesize\sffamily\color{black!60}#1}
\renewcommand{\Comment}[1]{\hfill\(\triangleright\)\ \textit{#1}}

\newcommand{\Break}{\cc@kw{break}}
\newcommand{\Continue}{\cc@kw{continue}}

% pseudocode = algorithmic with line numbers and a slightly smaller font
\newenvironment{pseudocode}
  {\small\begin{algorithmic}[1]}
  {\end{algorithmic}}

% ---------- Math: dataflow analysis ----------
% Wrapped in \ensuremath so the macros work in running text as well as in
% math mode; new chapters use them outside $...$ and the build requires it.
\newcommand{\In}[1]{\ensuremath{\mathrm{IN}[#1]}}
\newcommand{\Out}[1]{\ensuremath{\mathrm{OUT}[#1]}}
\newcommand{\Gen}[1]{\ensuremath{\mathrm{GEN}[#1]}}
\newcommand{\Kill}[1]{\ensuremath{\mathrm{KILL}[#1]}}
\newcommand{\LiveIn}[1]{\ensuremath{\mathrm{LiveIn}[#1]}}
\newcommand{\LiveOut}[1]{\ensuremath{\mathrm{LiveOut}[#1]}}
\newcommand{\Tf}[1]{\ensuremath{f_{#1}}}          % transfer function f_B
\newcommand{\meet}{\ensuremath{\sqcap}}           % lattice meet
\newcommand{\join}{\ensuremath{\sqcup}}           % lattice join

% ---------- Math: SSA ----------
\newcommand{\phifn}[1]{\ensuremath{\phi(#1)}}
\newcommand{\assignphi}[2]{\ensuremath{#1 \gets \phi(#2)}}

% ---------- Math: control-flow graphs ----------
\DeclareMathOperator{\Pred}{Pred}
\DeclareMathOperator{\Succ}{Succ}
\DeclareMathOperator{\dom}{dom}
\DeclareMathOperator{\idom}{idom}
\DeclareMathOperator{\DF}{DF}
\DeclareMathOperator{\Def}{Def}
\DeclareMathOperator{\Use}{Use}
\newcommand{\Entry}{\textsf{ENTRY}}
\newcommand{\Exit}{\textsf{EXIT}}

% Set-builder: \set{x \in S | x > 0}
\newcommand{\set}[1]{\{\,\cc@setbody#1\relax\,\}}
\def\cc@setbody#1|#2\relax{#1 \mid #2}

% ---------- IR listings ----------
\lstdefinelanguage{ir}{
  morekeywords={add,sub,mul,sdiv,udiv,srem,urem,and,or,xor,shl,shr,
                load,store,alloca,br,jmp,ret,call,phi,icmp,select,label,
                goto,if,param,cmp,mov},
  sensitive=true,
  morecomment=[l]{;},
  morestring=[b]",
}
\lstnewenvironment{irlisting}[1][]
  {\lstset{language=ir,#1}}
  {}

% ---------- TikZ styles for CFG figures ----------
\tikzset{
  basic block/.style={
    draw, rectangle, rounded corners=2pt, align=left,
    font=\ttfamily\footnotesize, inner sep=4pt, minimum width=1.6cm
  },
  cfg edge/.style={-{Stealth[length=2mm]}, semithick},
  back edge/.style={-{Stealth[length=2mm]}, semithick, dashed},
  block label/.style={font=\sffamily\bfseries\scriptsize, anchor=south west, inner sep=1pt},
}

\endinput
