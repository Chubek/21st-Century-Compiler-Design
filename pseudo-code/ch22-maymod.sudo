# slug: ch22-maymod
# source: chapters/ch22.tex:76 (approximate line of \begin{algorithm})
# caption: May-modify summaries over the call graph
# label: alg:ch22-maymod
# require: fixed sound call graph, conservative direct store sets Direct(P) including external effects
# ensure: least fixed point of may-modify sets Mod(P)
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE fixed sound call graph, conservative direct store sets Direct(P) including external effects
ENSURE least fixed point of may-modify sets Mod(P)
Mod(P) <- Direct(P) for every procedure P
W <- all procedures
WHILE W != {} DO
  remove some P from W
  New <- Direct(P) UNION BIG-UNION[Q called by P] Mod(Q)
  IF New != Mod(P) THEN
    Mod(P) <- New
    add every caller of P to W
  END IF
END WHILE

