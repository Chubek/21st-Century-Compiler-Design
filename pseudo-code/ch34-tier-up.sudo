# slug: ch34-tier-up
# source: chapters/ch34.tex:79 (approximate line of \begin{algorithm})
# caption: Tier promotion from counters and profile maturity
# label: alg:ch34-tier-up
# require: method m with entry count c[e], back-edge count c[b], profile state p
# ensure: tier decision for m
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE method m with entry count c[e], back-edge count c[b], profile state p
ENSURE tier decision for m
heat <- c[e] + c[b]
IF heat < T[base] THEN
  RETURN stay in interpreter
END IF
IF heat < T[opt] THEN
  RETURN compile with baseline JIT
END IF
IF p is mature THEN
  RETURN compile with optimizing JIT
END IF
RETURN compile with baseline JIT and keep profiling

