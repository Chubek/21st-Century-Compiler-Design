# slug: ch34-tier-up
# source: chapters/ch34.tex:79
# label: alg:ch34-tier-up
# pseudocode source: chapters/ch34.tex:81
# caption: Tier promotion from counters and profile maturity

REQUIRE method m with entry count c_e, back-edge count c_b, profile state p
ENSURE tier decision for m
heat <- c_e + c_b
IF heat < T_{base} THEN
  RETURN stay in interpreter
END IF
IF heat < T_{opt} THEN
  RETURN compile with baseline JIT
END IF
IF p is mature THEN
  RETURN compile with optimizing JIT
END IF
RETURN compile with baseline JIT and keep profiling

