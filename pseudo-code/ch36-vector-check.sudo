# slug: ch36-vector-check
# source: chapters/ch36.tex:81
# label: alg:ch36-vector-check
# pseudocode source: chapters/ch36.tex:83
# caption: Legality check for vectorizing an affine loop nest

REQUIRE affine loop nest L, complete scalar and memory dependence information, operations safe for proposed lane execution
ENSURE verdict: vectorize, parallelize, or reject with cause
D <- all dependences with distance and direction
IF any pair may alias without disambiguation THEN
  RETURN reject with cause
END IF
IF there is a reduction and all loop-carried dependences belong to it, with a legal combine order THEN
  RETURN parallelize with tree reduction
END IF
IF any remaining loop-carried dependence exists on the target loop THEN
  RETURN reject with cause
END IF
RETURN vectorize innermost loop

