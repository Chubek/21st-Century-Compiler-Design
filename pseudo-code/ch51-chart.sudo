# slug: ch51-chart
# source: chapters/ch51.tex:216
# label: alg:ch51-chart
# pseudocode source: chapters/ch51.tex:219
# caption: Recognize a token CFG by chart saturation, including nullable completions.

REQUIRE finite token CFG, tokens t_0,...,t_{n-1}, fresh start S' -> S
ENSURE accept exactly when a complete start item reaches column n
C_0 <- {[S' -> . S,0]}; other columns empty
FOR j=0,...,n DO
  REPEAT
    FORALL items [A -> alpha . Bbeta,i] in C_j with nonterminal B DO
      insert [B -> . gamma,j] for every production B -> gamma
    END FOR
    FORALL complete items [B -> gamma . ,i] in C_j DO
      FORALL items [A -> alpha . Bbeta,h] in C_i DO
        insert [A -> alpha B . beta,h] into C_j
      END FOR
    END FOR
  UNTIL C_j stops growing
  IF j<n THEN
    advance every item expecting terminal t_j into C_{j+1}
  END IF
END FOR
RETURN whether [S' -> S . ,0] in C_n

