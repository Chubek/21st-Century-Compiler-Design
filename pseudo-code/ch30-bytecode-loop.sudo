# slug: ch30-bytecode-loop
# source: chapters/ch30.tex:118 (approximate line of \begin{algorithm})
# caption: Bytecode dispatch loop with explicit errors and fuel
# label: alg:ch30-bytecode-loop
# require: decoded program P of n instructions, state S, integer fuel F >= 0, terminating handlers
# ensure: halts with result, error, or out-of-fuel
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE decoded program P of n instructions, state S, integer fuel F >= 0, terminating handlers
ENSURE halts with result, error, or out-of-fuel
pc <- 0
fuel <- F
WHILE pc != n DO
  IF pc < 0 or pc > n THEN
    RETURN invalid program counter
  END IF
  IF fuel = 0 THEN
    RETURN out-of-fuel
  END IF
  fuel <- fuel - 1
  op <- P[pc].opcode
  IF op is undefined THEN
    RETURN error at pc
  END IF
  execute checked handler on S; return any reported error immediately
  accept its next pc only if it is a valid target or the permitted end n
END WHILE
RETURN result in S

