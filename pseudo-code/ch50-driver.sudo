# slug: ch50-driver
# source: chapters/ch50.tex:223
# label: alg:ch50-driver
# pseudocode source: chapters/ch50.tex:226
# caption: Recognize with a conflict-free predictive table.

REQUIRE token sequence with one end marker, start S, predictive table M
ENSURE accept exactly when the entire sequence derives from S
stack <- [S,end], with top at the left; cursor i <- 0
WHILE stack is nonempty DO
  X <- pop stack; a <- lookahead at i
  IF X is a terminal or end marker THEN
    IF X != a THEN
      RETURN syntax error
    END IF
    i <- i+1
  ELSE
    IF M[X,a] is empty THEN
      RETURN syntax error
    END IF
    push the selected RHS in reverse order, omitting epsilon
  END IF
END WHILE
RETURN accept

