# slug: ch13-simplify
# source: chapters/ch13.tex:78 (approximate line of \begin{algorithm})
# caption: Local simplification to a normal form within one block
# label: alg:ch13-simplify
# require: block B with instructions i[1] to i[n], ordered rule set R with decreasing measure
# ensure: B in normal form: no rule in R applies to any instruction
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE block B with instructions i[1] to i[n], ordered rule set R with decreasing measure
ENSURE B in normal form: no rule in R applies to any instruction
W <- all instructions in B
WHILE W != {} DO
  remove some j from W
  FORALL rules r in R in priority order DO
    IF r matches j and its guard holds THEN
      rewrite j by r
      add surviving j, its users, and new neighbors in B to W
      BREAK out of the rule loop to re-examine j
    END IF
  END FOR
END WHILE

