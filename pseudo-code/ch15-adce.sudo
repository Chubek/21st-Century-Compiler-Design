# slug: ch15-adce
# source: chapters/ch15.tex:71
# label: alg:ch15-adce
# pseudocode source: chapters/ch15.tex:73
# caption: Conservative marking-based dead-code elimination

REQUIRE CFG G with explicit effects and traps, and complete reaching-definition links
ENSURE unused pure definitions removed; all original control flow retained
Live <- roots: all terminators, observable uses, stores, and operations not proved pure, total, and nontrapping
MarkedB <- blocks holding roots
W <- all root instructions
WHILE W != {} DO
  remove some i from W
  FORALL operands v used by i DO
    FORALL definitions d of v that can reach i DO
      IF d unmarked THEN
        mark d and add d to W
      END IF
    END FOR
  END FOR
  FORALL branches c that i is control dependent on DO
    IF c unmarked THEN
      mark c and add c to W
    END IF
  END FOR
END WHILE
delete unmarked pure definitions; retain all terminators and blocks

