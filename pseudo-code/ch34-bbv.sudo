# slug: ch34-bbv
# source: chapters/ch34.tex:140
# label: alg:ch34-bbv
# pseudocode source: chapters/ch34.tex:143
# caption: Lazy basic block versioning under a version budget.

REQUIRE control-flow graph with entry E, version limit K per block, generic fallback for every block
ENSURE specialized versions for observed contexts plus fallback coverage for the rest
compile version v_0 of E under the first observed entry context
Pending <- {(E, v_0)}
WHILE Pending != {} DO
  remove some (B, v) from Pending
  FORALL successors S of B along the observed edge DO
    c <- context propagated from v to S
    IF a version of S already covers c THEN
      route the edge there
    ELSE IF S has fewer than K versions THEN
      compile a new version of S under c
      add it to Pending
    ELSE
      route the edge to the generic version of S
    END IF
  END FOR
END WHILE

