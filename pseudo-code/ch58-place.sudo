# slug: ch58-place
# source: chapters/ch58.tex:62
# label: alg:ch58-place
# pseudocode source: chapters/ch58.tex:65
# caption: Place one input section in a bounded region.

REQUIRE region base B, capacity C, used extent u, section size n, alignments
ENSURE aligned nonoverlapping placement inside the region, or a diagnostic
a <- max(inputAlignment,ruleAlignment); validate supported power of two
v <- checkedAlignUp(B+u,a)
o <- v-B
require o <= C and n <= C-o
record input section address v and region offset o
IF n>0 THEN
  update used extent to o+n
END IF

