# slug: ch84-pairs
# source: chapters/ch84.tex:51
# label: alg:ch84-pairs
# pseudocode source: chapters/ch84.tex:54
# caption: Enumerate first-order critical overlaps with disjoint variable namespaces.

REQUIRE finite well-formed first-order rewrite rules
ENSURE critical pairs from all nonvariable left-side overlaps
FORALL ordered rule pairs (l_1 -> r_1,l_2 -> r_2) DO
  rename the two variable sets apart
  FORALL nonvariable positions p in l_2 DO
    attempt finite-term unification of l_1 and l_2|_p
    IF unifier sigma exists THEN
      emit (l_2[r_1]_psigma,r_2sigma) unless both terms are equal
    END IF
  END FOR
END FOR

