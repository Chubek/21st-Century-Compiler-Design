# label: alg:ch66-transfer
# pseudocode source: chapters/ch66.tex:67
# caption: Run a narrow speculative loop with loop-header recovery.

REQUIRE input sequence, valid loop-header frame (i,total,trace)
ENSURE the baseline outcome and observable event sequence
WHILE i is below the input length DO
  v <- input element at i
  IF v is not an exact integer THEN
    RETURN baseline execution from the current frame
  END IF
  compute candidate sum without host-language overflow
  IF the candidate is outside [-128,127] THEN
    reconstruct the current frame
    RETURN baseline execution from that frame
  END IF
  commit the candidate sum and append its event
  i <- i+1
END WHILE
RETURN successful baseline-format outcome

