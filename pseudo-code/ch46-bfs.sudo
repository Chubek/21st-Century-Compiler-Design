# slug: ch46-bfs
# source: chapters/ch46.tex:39
# label: alg:ch46-bfs
# pseudocode source: chapters/ch46.tex:42
# caption: Search for a bad state and retain a shortest transition witness.

REQUIRE finite graph with complete adjacency lists, initial set I, bad set B
ENSURE a shortest path from I to B, or proof that no such path exists
D <- {}; W <- empty FIFO queue
FORALL s in I DO
  D <- D UNION {s}; parent[s] <- BOTTOM; enqueue s in W
END FOR
WHILE W != {} DO
  s <- dequeue from W
  IF s in B THEN
    RETURN reverse of the parent chain from s to BOTTOM
  END IF
  FORALL t in Succ(s) DO
    IF t not in D THEN
      D <- D UNION {t}; parent[t] <- s; enqueue t in W
    END IF
  END FOR
END WHILE
RETURN unreachable

