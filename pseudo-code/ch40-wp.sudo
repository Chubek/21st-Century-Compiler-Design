# label: alg:ch40-wp
# pseudocode source: chapters/ch40.tex:257
# caption: Construct a weakest precondition for a loop-free command.

REQUIRE Command C built from skip, assignment, sequence, and conditionals
REQUIRE Postcondition Q; pure, total expressions and guards
ENSURE Formula true exactly in the states from which C establishes Q
FUNCTION WP(C,Q)
  IF C is skip THEN
    RETURN Q
  ELSE IF C is x:=e THEN
    Rename binders in Q that would capture free variables of e
    RETURN Q[e/x] using structural substitution
  ELSE IF C is C_1;C_2 THEN
    R <- WP(C_2,Q)
    RETURN WP(C_1,R)
  ELSE // C is if b then C_t else C_f
    R_t <- WP(C_t,Q)
    R_f <- WP(C_f,Q)
    RETURN (b -> R_t) AND (NOT b -> R_f)
  END IF
END FUNCTION

