# slug: ch54-symbol-order
# source: chapters/ch54.tex:241
# label: alg:ch54-symbol-order
# pseudocode source: chapters/ch54.tex:244
# caption: Serialize symbols without invalidating relocation identities.

REQUIRE internal symbols with stable identifiers, fixups referencing those identifiers
ENSURE ELF local-first ordering and correct relocation symbol indices
emit the all-zero symbol entry at index zero
FORALL local symbols, then nonlocal symbols, retaining order within each group DO
  assign the next ELF index and record map[internal] <- index
  emit the symbol name offset, binding, section index, and value
END FOR
record the first nonlocal index in the symbol-table section header
FORALL fixups DO
  translate the internal target through map
  emit relocation offset, translated symbol/type pair, and addend
END FOR

