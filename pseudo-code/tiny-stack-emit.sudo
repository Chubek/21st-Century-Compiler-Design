# slug: tiny-stack-emit
# source: chapters/ch01/stack-translation.tex:95 (approximate line of \begin{algorithm})
# caption: Emit stack instructions for an expression.
# label: alg:tiny-stack-emit
# require: A valid expression tree e; an instruction sequence with enough capacity
# ensure: Append C(e) without changing the existing instruction prefix
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE A valid expression tree e; an instruction sequence with enough capacity
ENSURE Append C(e) without changing the existing instruction prefix
FUNCTION Emit(e)
  IF e = lit(n) THEN
    append PUSH n
  ELSE IF e = x THEN
    append GET[I] NPUT
  ELSE
    Call Emit(left(e))
    Call Emit(right(e))
    append ADD8 or MUL8 according to e's operator
  END IF
END FUNCTION

