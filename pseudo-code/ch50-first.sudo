# slug: ch50-first
# source: chapters/ch50.tex:64
# label: alg:ch50-first
# pseudocode source: chapters/ch50.tex:67
# caption: Compute nullable flags and terminal FIRST sets to a fixed point.

REQUIRE finite grammar with defined symbols
ENSURE nullable and FIRST for every nonterminal, excluding epsilon from FIRST
initialize terminal facts; initialize nonterminal facts to empty/false
REPEAT
  changed <- false
  FORALL productions A -> X_1... X_k DO
    all <- true
    FOR j=1,...,k DO
      union FIRST(X_j) into FIRST(A)
      IF X_j is not nullable THEN
        all <- false; BREAK
      END IF
    END FOR
    IF all THEN
      mark A nullable
    END IF
    record whether any set or flag changed
  END FOR
UNTIL nothing changed

