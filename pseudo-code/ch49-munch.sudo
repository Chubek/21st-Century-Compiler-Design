# slug: ch49-munch
# source: chapters/ch49.tex:247
# label: alg:ch49-munch
# pseudocode source: chapters/ch49.tex:250
# caption: Select one longest token while preserving the last accepting endpoint.

REQUIRE source s of length n, start offset b<n, nonnullable token DFA
ENSURE longest token and endpoint, or lexical failure at b
q <- start; i <- b; best <- none
WHILE i<n and the next transition is not dead DO
  q <- delta(q,s[i]); i <- i+1
  IF q has a token output THEN
    best <- (i,output(q))
  END IF
END WHILE
IF best=none THEN
  RETURN lexical failure at b
END IF
RETURN token spanning [b,best.end), with next cursor best.end

