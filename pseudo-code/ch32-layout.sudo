# slug: ch32-layout
# source: chapters/ch32.tex:83
# label: alg:ch32-layout
# pseudocode source: chapters/ch32.tex:85
# caption: Field offset assignment for single-inheritance classes

REQUIRE header size H and alignment, root-to-leaf field list F, power-of-two alignments, checked size arithmetic
ENSURE offset off(f) for each field and total size S
cur <- H
align_{max} <- header alignment
FORALL f in F DO
  cur <- round cur up to alignment of f
  off(f) <- cur
  cur <- cur + size of f
  align_{max} <- max(align_{max}, alignment of f)
END FOR
S <- round cur up to align_{max}
RETURN offsets and S

