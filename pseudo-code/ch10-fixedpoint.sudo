# slug: ch10-fixedpoint
# source: chapters/ch10.tex:88
# label: alg:ch10-fixedpoint
# pseudocode source: chapters/ch10.tex:90
# caption: Generic lattice fixed-point iteration with a worklist

REQUIRE reachable CFG G with predecessor-free entry, finite-height lattice, monotone transfers, s=TOP, entry boundary
ENSURE assignment X[B] that satisfies all equations and is extremal from start s
X[B] <- s for every block B
W <- all blocks in G
WHILE W != {} DO
  remove some B from W
  in <- MEET_{P in Pred(B)} f_{P}(X[P]), or boundary where B has no predecessor
  new <- in
  IF new != X[B] THEN
    X[B] <- new
    add Succ(B) to W
  END IF
END WHILE

