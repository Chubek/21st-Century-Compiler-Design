# slug: ch42-invalidate
# source: chapters/ch42.tex:254
# label: alg:ch42-invalidate
# pseudocode source: chapters/ch42.tex:257
# caption: Invalidate the transitive readers of changed dependencies.

REQUIRE complete reader graph R, changed dependency keys D
ENSURE every cached result transitively depending on D is invalid
W <- D; Seen <- D
WHILE W != {} DO
  remove u from W
  mark the cached result for u invalid, if one exists
  FORALL v in R[u] DO
    IF v not in Seen THEN
      insert v into Seen and W
    END IF
  END FOR
END WHILE

