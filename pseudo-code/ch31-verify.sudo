# slug: ch31-verify
# source: chapters/ch31.tex:129
# label: alg:ch31-verify
# pseudocode source: chapters/ch31.tex:131
# caption: Stack-depth verification over a bytecode control-flow graph

REQUIRE decoded array P, entry depth d_0, pop count p(i) and push count q(i)
ENSURE depth map D or a verification error
build CFG with successors for branches, jumps, and fall-through
set D[v] <- unknown for all v, D[entry] <- d_0
W <- {entry}
WHILE W != {} DO
  remove some v from W
  IF D[v] < p(v) THEN
    RETURN underflow at v
  END IF
  d <- D[v]-p(v)+q(v)
  reject arithmetic overflow or d above the configured stack capacity
  reject invalid branch targets and invalid return depths
  FORALL s in Succ(v) DO
    IF D[s] is unknown THEN
      D[s] <- d
      add s to W
    ELSE IF D[s] != d THEN
      RETURN depth mismatch at s
    END IF
  END FOR
END WHILE
RETURN D

