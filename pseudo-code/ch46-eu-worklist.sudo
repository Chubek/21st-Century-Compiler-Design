# slug: ch46-eu-worklist
# source: chapters/ch46.tex:145
# label: alg:ch46-eu-worklist
# pseudocode source: chapters/ch46.tex:148
# caption: Compute existential until by backward propagation from its target set.

REQUIRE finite graph with predecessor lists; state sets P and Q
ENSURE X=[[E[P U Q]]] and witness pointers outside Q
X <- Q; W <- FIFO queue containing every state of Q
WHILE W != {} DO
  t <- dequeue from W
  FORALL s in Pred(t) DO
    IF s in P and s not in X THEN
      X <- X UNION {s}; next[s] <- t; enqueue s in W
    END IF
  END FOR
END WHILE
RETURN X,next

