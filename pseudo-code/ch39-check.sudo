# slug: ch39-check
# source: chapters/ch39.tex:82 (approximate line of \begin{algorithm})
# caption: Syntax-directed checking for Mini-Fun.
# label: alg:ch39-check
# require: checked scope structure, expression e, context Gamma mapping bound names to types
# ensure: type T of e under Gamma, or a diagnostic naming the failing node
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE checked scope structure, expression e, context Gamma mapping bound names to types
ENSURE type T of e under Gamma, or a diagnostic naming the failing node
FUNCTION Check(Gamma, e)
  IF e is a variable x THEN
    IF x is bound in Gamma THEN RETURN Gamma(x)
    ELSE RETURN diagnostic undefined name at e
    END IF
  ELSE IF e is an integer literal THEN RETURN int
  ELSE IF e is a boolean literal THEN RETURN bool
  ELSE IF e is e1 + e2 or e1 < e2 THEN
    T1 <- Check(Gamma, e1); propagate any diagnostic
    T2 <- Check(Gamma, e2); propagate any diagnostic
    require T1 = T2 = int or report operator kinds at e
    RETURN int for + and bool for <
  ELSE IF e is if c then e1 else e2 THEN
    require Check(Gamma, c) = bool or report the test kind at c
    T1 <- Check(Gamma, e1); T2 <- Check(Gamma, e2)
    require T1 = T2 or report the arm mismatch at e
    RETURN T1
  ELSE IF e is lam(x : T1, b) THEN
    RETURN T1 -> Check(Gamma, x : T1, b)
  ELSE IF e is app(e1, e2) THEN
    F <- Check(Gamma, e1); A <- Check(Gamma, e2)
    require F = T1 -> T2 with A = T1 or report the call mismatch at e
    RETURN T2
  END IF
END FUNCTION

