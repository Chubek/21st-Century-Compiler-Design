# slug: ch39-check
# source: chapters/ch39.tex:82
# label: alg:ch39-check
# pseudocode source: chapters/ch39.tex:85
# caption: Syntax-directed checking for Mini-Fun.

REQUIRE checked scope structure, expression e, context Gamma mapping bound names to types
ENSURE type T of e under Gamma, or a diagnostic naming the failing node
FUNCTION Check(Gamma, e)
  IF e is a variable x THEN
    IF x is bound in Gamma THEN RETURN Gamma(x)
    ELSE RETURN diagnostic undefined name at e
    END IF
  ELSE IF e is an integer literal THEN RETURN int
  ELSE IF e is a boolean literal THEN RETURN bool
  ELSE IF e is e_1 + e_2 or e_1 < e_2 THEN
    T_1 <- Check(Gamma, e_1); propagate any diagnostic
    T_2 <- Check(Gamma, e_2); propagate any diagnostic
    require T_1 = T_2 = int or report operator kinds at e
    RETURN int for + and bool for <
  ELSE IF e is if c then e_1 else e_2 THEN
    require Check(Gamma, c) = bool or report the test kind at c
    T_1 <- Check(Gamma, e_1); T_2 <- Check(Gamma, e_2)
    require T_1 = T_2 or report the arm mismatch at e
    RETURN T_1
  ELSE IF e is lam(x : T_1, b) THEN
    RETURN T_1 -> Check(Gamma, x : T_1, b)
  ELSE IF e is app(e_1, e_2) THEN
    F <- Check(Gamma, e_1); A <- Check(Gamma, e_2)
    require F = T_1 -> T_2 with A = T_1 or report the call mismatch at e
    RETURN T_2
  END IF
END FUNCTION

