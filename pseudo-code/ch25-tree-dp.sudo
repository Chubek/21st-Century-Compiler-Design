# slug: ch25-tree-dp
# source: chapters/ch25.tex:100
# label: alg:ch25-tree-dp
# pseudocode source: chapters/ch25.tex:102
# caption: Tree-pattern instruction selection by dynamic programming

REQUIRE expression tree T, finite tree patterns P with additive costs and proper-subtree frontier operands
ENSURE cheapest cover for the requested root result kind, or failure if none exists
FORALL node n in postorder DO
  set Cost(n, k) <- infinity for each result kind k
  FORALL rule r in P matching n DO
    check operand predicates and constant ranges
    c <- Cost(r) + SUM_{f in frontier(r,n)} Cost(f, kind(r,f))
    IF c < Cost(n, kind(r)) THEN
      record Cost(n, kind(r)) <- c with rule r
    END IF
  END FOR
END FOR
reject if the required root cost is infinite
follow recorded rules, emitting frontier operands before their consuming instruction

