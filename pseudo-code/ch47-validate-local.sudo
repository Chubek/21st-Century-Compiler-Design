# slug: ch47-validate-local
# source: chapters/ch47.tex:122
# label: alg:ch47-validate-local
# pseudocode source: chapters/ch47.tex:125
# caption: Validate a deterministic, terminating local rewrite.

REQUIRE acyclic regions S,T, input precondition P, exact operation semantics
ENSURE valid under P, a replayed counterexample, or inconclusive
check structural validity, input alignment, and supported operations
IF a required check fails THEN
  RETURN inconclusive with the failed check
END IF
construct symbolic observations O_S(i) and O_T(i)
q <- P(i) AND (O_S(i) != O_T(i))
r <- Solve(q)
IF r is UNSAT THEN
  RETURN valid under P and the encoded semantics
ELSE IF r is SAT with assignment a THEN
  evaluate P(a), S(a), and T(a) using concrete semantics
  IF P(a) holds and the concrete observations differ THEN
    RETURN counterexample a and both observations
  END IF
  RETURN inconclusive: encoding or replay disagreement
ELSE
  RETURN inconclusive with the solver status
END IF

