# slug: ch17-licm
# source: chapters/ch17.tex:58 (approximate line of \begin{algorithm})
# caption: Loop-invariant code motion to the preheader
# label: alg:ch17-licm
# require: SSA loop L with preheader P, pure total operations only
# ensure: invariant computations satisfying the hoist conditions move to P
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE SSA loop L with preheader P, pure total operations only
ENSURE invariant computations satisfying the hoist conditions move to P
Inv <- empty set of invariant instructions
changed <- true
WHILE changed DO
  changed <- false
  FOR each instruction I in L defining v <- e DO
    IF I not in Inv is not a phi and every operand is constant, defined outside L, or in Inv THEN
      add I to Inv; changed <- true
    END IF
  END FOR
END WHILE
FOR each I defining v in Inv, in operand-before-user order DO
  IF v has one definition in L and I dominates the exits where v is live THEN
    IF I is pure and total and every operand is available in P THEN
      move I immediately before the terminator of P
    END IF
  END IF
END FOR

