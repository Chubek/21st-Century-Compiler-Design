# slug: ch44-store
# source: chapters/ch44.tex:233
# label: alg:ch44-store
# pseudocode source: chapters/ch44.tex:236
# caption: Update an abstract heap for a valid whole-field store.

REQUIRE heap H, nonempty sound target set T, stored abstract value v
REQUIRE nonoverlapping fields; sound singleton-target predicate One
ENSURE returned heap covers every normal concrete store result
H' <- a copy of H
IF T={(a,f)} and One(a,f) THEN
  H'(a,f) <- v
ELSE
  FORALL (a,f) in T DO
    H'(a,f) <- H(a,f)JOIN v
  END FOR
END IF
RETURN H'

