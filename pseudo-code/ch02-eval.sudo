# slug: ch02-eval
# source: chapters/ch02.tex:123 (approximate line of \begin{algorithm})
# caption: Tree-walking evaluation of Mini statements and expressions.
# label: alg:ch02-eval
# require: syntax tree node N, environment E, output list O
# ensure: if evaluation terminates, a value or unit with updated state, or a runtime error
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE syntax tree node N, environment E, output list O
ENSURE if evaluation terminates, a value or unit with updated state, or a runtime error
FUNCTION Eval(N, E, O)
  IF N is a number THEN
    RETURN its value with E and O unchanged
  ELSE IF N is a variable THEN
    RETURN the looked-up binding or an undefined-variable error
  ELSE IF N is an arithmetic or comparison THEN
    evaluate the left child, then the right child
    combine the two values with the operator
  ELSE IF N is a sequence THEN
    evaluate the first child, threading E and O into the second
  ELSE IF N is an assignment THEN
    evaluate the value, update its resolved binding in E, and return unit
  ELSE IF N is a let binding THEN
    evaluate the initializer, extend E for the body, and restore the outer scope afterward
  ELSE IF N is a print THEN
    evaluate the child and append the result to O
  ELSE IF N is a conditional THEN
    evaluate the test once and evaluate exactly one branch
  ELSE IF N is a loop THEN
    WHILE the test evaluates to true DO
      evaluate the body
    END WHILE
  END IF
END FUNCTION

