# slug: trap-guarded-fold
# source: chapters/ch01/traps-effects.tex:278
# label: alg:trap-guarded-fold
# pseudocode source: chapters/ch01/traps-effects.tex:281
# caption: Fold constants in the presence of a trapping division.

REQUIRE A finite, non-sharing tree with div nodes
ENSURE Same trap-or-value for every input a in V
FUNCTION GuardedFold(e)
  IF e is a literal or the input node THEN
    RETURN e
  END IF
  p <- GuardedFold(left(e))
  q <- GuardedFold(right(e))
  IF p=lit(u) and q=lit(v) THEN
    IF e is an addition THEN
      RETURN lit((u+v) mod 256)
    ELSE IF e is a multiplication THEN
      RETURN lit((u * v) mod 256)
    ELSE
      IF v=0 THEN
        RETURN a division node with children p,q
      ELSE
        RETURN lit(u/v)
      END IF
    END IF
  END IF
  RETURN a node with e's operator and children p,q
END FUNCTION

