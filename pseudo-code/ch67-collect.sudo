# slug: ch67-collect
# source: chapters/ch67.tex:114
# label: alg:ch67-collect
# pseudocode source: chapters/ch67.tex:117
# caption: Reclaim retired artifacts in a lease-complete serialized model.

REQUIRE every possible use owns a lease, version list, serialized owner
ENSURE no artifact with a possible outstanding use is reclaimed
FORALL versions v DO
  IF v is retired and its lease count is zero THEN
    remove v from the owned version list
    release its code and metadata resources
  END IF
END FOR

