# slug: ch35-deopt
# source: chapters/ch35.tex:85 (approximate line of \begin{algorithm})
# caption: Deoptimization after a failed guard
# label: alg:ch35-deopt
# require: failed guard g, complete descriptor D(g), live compiled frame F[c]; one logical interpreter frame
# ensure: interpreter frame F[i] resumed at the recorded index
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE failed guard g, complete descriptor D(g), live compiled frame F[c]; one logical interpreter frame
ENSURE interpreter frame F[i] resumed at the recorded index
idx <- bytecode index in D(g)
F[i] <- fresh interpreter frame for the same method
FORALL v live in the interpreter at idx DO
  loc <- compiled location of v in D(g)
  materialize v in F[i] from loc  # rebox or reload as recorded
END FOR
discard F[c] temporaries not present in the interpreter
resume interpretation at idx with F[i]

