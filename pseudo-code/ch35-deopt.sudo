# label: alg:ch35-deopt
# pseudocode source: chapters/ch35.tex:87
# caption: Deoptimization after a failed guard

REQUIRE failed guard g, complete descriptor D(g), live compiled frame F_c; one logical interpreter frame
ENSURE interpreter frame F_i resumed at the recorded index
idx <- bytecode index in D(g)
F_i <- fresh interpreter frame for the same method
FORALL v live in the interpreter at idx DO
  loc <- compiled location of v in D(g)
  materialize v in F_i from loc // rebox or reload as recorded
END FOR
discard F_c temporaries not present in the interpreter
resume interpretation at idx with F_i

