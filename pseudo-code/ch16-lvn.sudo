# slug: ch16-lvn
# source: chapters/ch16.tex:78 (approximate line of \begin{algorithm})
# caption: Local value numbering with current value holders
# label: alg:ch16-lvn
# require: block B of pure total scalar assignments with defined inputs
# ensure: reuse only equal values with a current holder or literal representative
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE block B of pure total scalar assignments with defined inputs
ENSURE reuse only equal values with a current holder or literal representative
keynum <- empty map from expression key to value number
varnum <- empty map from variable to value number
holders <- empty map from number to set of current variables
FOR each instruction I in B in order DO
  record destination v; give unknown input variables fresh numbers and register their holders
  read operand numbers before changing varnum[v]
  fold literal-only operations; intern typed literals by value
  copies use their source number; other operations use a canonical typed key
  n <- source number for a copy; otherwise look up or intern the value's key in keynum
  IF n has a literal representative or a nonempty holder set THEN
    replace I with that literal or a copy from a current holder of n
  END IF
  remove v from its former holder set, if any
  varnum[v] <- n; add v to holders[n]
END FOR

