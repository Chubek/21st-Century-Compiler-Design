# slug: ch78-search
# source: chapters/ch78.tex:78
# label: alg:ch78-search
# pseudocode source: chapters/ch78.tex:81
# caption: Find every exact match, including overlapping matches.

REQUIRE text s, pattern p, its prefix function when nonempty
ENSURE all match start positions in increasing order
IF |p|=0 THEN
  return every boundary 0 through |s|
END IF
j <- 0
FOR i=0 to |s|-1 DO
  WHILE j>0 and s[i] != p[j] DO
    j <- pi[j-1]
  END WHILE
  IF s[i]=p[j] THEN
    j <- j+1
  END IF
  IF j=|p| THEN
    report i+1-|p|; j <- pi[j-1]
  END IF
END FOR

