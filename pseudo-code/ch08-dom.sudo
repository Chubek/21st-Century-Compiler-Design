# slug: ch08-dom
# source: chapters/ch08.tex:70 (approximate line of \begin{algorithm})
# caption: Iterative computation of dominator sets.
# label: alg:ch08-dom
# require: control-flow graph with entry E and reachable block set V
# ensure: dom(B) for every block B
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE control-flow graph with entry E and reachable block set V
ENSURE dom(B) for every block B
FUNCTION Dominators(E, V)
  set dom(E) to {E} and every other dom(B) to V
  changed <- true
  WHILE changed DO
    changed <- false
    FORALL blocks B other than E DO
      new <- {B} UNION BIG-INTERSECT[P in Pred(B)] dom(P)
      IF new != dom(B) THEN
        dom(B) <- new; changed <- true
      END IF
    END FOR
  END WHILE
  RETURN all dom(B) sets
END FUNCTION

