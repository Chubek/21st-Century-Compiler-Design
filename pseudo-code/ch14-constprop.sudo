# slug: ch14-constprop
# source: chapters/ch14.tex:66 (approximate line of \begin{algorithm})
# caption: Forward constant propagation on the flat lattice
# label: alg:ch14-constprop
# require: entry-reachable CFG with predecessor-free entry, monotone transfers Tf[B], sound boundary in[0]
# ensure: In[B] and Out[B] over-approximate runtime values; constants may be substituted
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE entry-reachable CFG with predecessor-free entry, monotone transfers Tf[B], sound boundary in[0]
ENSURE In[B] and Out[B] over-approximate runtime values; constants may be substituted
In[B] <- TOP and Out[B] <- TOP for every block B
In[entry] <- in[0]
W <- all blocks in G
WHILE W != {} DO
  remove some B from W
  in <- MEET[P in Pred(B)] Out[P], or in[0] if B is entry
  out <- Tf[B](in)
  IF in != In[B] or out != Out[B] THEN
    In[B] <- in
    Out[B] <- out
    add Succ(B) to W
  END IF
END WHILE

