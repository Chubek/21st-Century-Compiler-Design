# slug: ch14-constprop
# source: chapters/ch14.tex:66
# label: alg:ch14-constprop
# pseudocode source: chapters/ch14.tex:68
# caption: Forward constant propagation on the flat lattice

REQUIRE entry-reachable CFG with predecessor-free entry, monotone transfers f_{B}, sound boundary in_0
ENSURE In[B] and Out[B] over-approximate runtime values; constants may be substituted
In[B] <- TOP and Out[B] <- TOP for every block B
In[entry] <- in_0
W <- all blocks in G
WHILE W != {} DO
  remove some B from W
  in <- MEET_{P in Pred(B)} Out[P], or in_0 if B is entry
  out <- f_{B}(in)
  IF in != In[B] or out != Out[B] THEN
    In[B] <- in
    Out[B] <- out
    add Succ(B) to W
  END IF
END WHILE

