# slug: ch48-bfs
# source: chapters/ch48.tex:170
# label: alg:ch48-bfs
# pseudocode source: chapters/ch48.tex:173
# caption: Budgeted safety search with a replayable shortest trace.

REQUIRE Valid graph, nonempty initial set I, bad set B, dequeue budget L
ENSURE Safe, unsafe with a shortest trace, or resource limit
Q <- initial states in increasing order; D <- I; v <- 0
FORALL s in I DO
  parent[s] <- s
END FOR
WHILE Q is not empty DO
  IF v=L THEN
    RETURN resource limit
  END IF
  s <- popFront(Q); v <- v+1
  IF s in B THEN
    Follow parents from s to its root and reverse the sequence
    RETURN unsafe with that sequence
  END IF
  FORALL effective successors t of s, in increasing order DO
    IF t not in D THEN
      D <- D UNION {t}; parent[t] <- s
      Append t to Q
    END IF
  END FOR
END WHILE
RETURN safe

