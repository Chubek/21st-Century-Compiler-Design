# slug: ch51-sequence
# source: chapters/ch51.tex:97
# label: alg:ch51-sequence
# pseudocode source: chapters/ch51.tex:100
# caption: Parse a production suffix while retaining the enclosing continuation.

REQUIRE production r, symbol index j, start b, cursor i, children C, continuation k
ENSURE true only when this suffix and the enclosing context both succeed
FUNCTION Sequence(r,j,b,i,C,k)
  IF j equals RHS length THEN
    RETURN k(i,Node(r,b,i,C))
  END IF
  X <- r.rhs[j]
  define next(e,t)=Sequence(r,j+1,b,e,C+[t],k)
  IF X is a nonterminal THEN
    RETURN Choose(X,i,next)
  ELSE
    FORALL terminal matches (e,t) allowed by the lexical contract at i DO
      IF next(e,t) THEN
        RETURN true
      END IF
    END FOR
    RETURN false
  END IF
END FUNCTION

