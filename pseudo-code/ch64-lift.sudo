# slug: ch64-lift
# source: chapters/ch64.tex:59
# label: alg:ch64-lift
# pseudocode source: chapters/ch64.tex:62
# caption: Lift the fixed two-byte AL instruction subset.

REQUIRE byte buffer, known entry at offset zero, accepted opcode profile
ENSURE SSA value rows with original offsets, or explicit rejection
pc <- 0; current <- entry low-byte value
WHILE pc is below the buffer length DO
  reject unless opcode is accepted and one immediate byte remains
  allocate fresh value name v
  emit the opcode's byte operation with source current and immediate
  associate its flag contract and source offset pc
  current <- v; pc <- pc+2
END WHILE
return the lifted rows and final low-byte value

