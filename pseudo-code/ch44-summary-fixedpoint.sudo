# slug: ch44-summary-fixedpoint
# source: chapters/ch44.tex:114
# label: alg:ch44-summary-fixedpoint
# pseudocode source: chapters/ch44.tex:117
# caption: Compute finite relational summaries for mutually recursive procedures.

REQUIRE finite procedures, boundary universe Q, sound finite local model
REQUIRE Eval computes tagged local reachability with matched calls
ENSURE S_P covers every normal terminating modeled pair for each P
S_P <- {} for every procedure P
LOOP
  FORALL procedures P DO
    T_P <- S_P UNION Eval(P,S)
  END FOR
  IF T_P=S_P for every P THEN
    RETURN S
  END IF
  S <- T
END LOOP

