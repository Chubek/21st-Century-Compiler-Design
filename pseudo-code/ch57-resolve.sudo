# slug: ch57-resolve
# source: chapters/ch57.tex:78
# label: alg:ch57-resolve
# pseudocode source: chapters/ch57.tex:81
# caption: Select a definition for one global name in an ordered object set.

REQUIRE all participating objects, one nonlocal name, strong/weak binding subset
ENSURE selected definition or a duplicate-definition diagnostic
chosen <- none
FORALL defined nonlocal symbols of that name in object order DO
  IF both the new symbol and chosen are strong THEN
    RETURN duplicate-definition error
  END IF
  IF chosen=none or a strong symbol replaces a weak choice THEN
    chosen <- new symbol with its owning object
  END IF
END FOR
RETURN chosen

