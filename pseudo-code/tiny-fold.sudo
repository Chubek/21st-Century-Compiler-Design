# slug: tiny-fold
# source: chapters/ch01.tex:339 (approximate line of \begin{algorithm})
# caption: Fold constant operations in a finite expression tree.
# label: alg:tiny-fold
# require: A finite, non-sharing tree e from Equation[see eq:tiny-expression-grammar]
# ensure: A tree with the same value for every input a in V
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE A finite, non-sharing tree e from Equation[see eq:tiny-expression-grammar]
ENSURE A tree with the same value for every input a in V
FUNCTION Fold(e)
  IF e is a literal or the input node THEN
    RETURN e
  END IF
  p <- Call Fold(left(e))
  q <- Call Fold(right(e))
  IF p = lit(u) and q = lit(v) THEN
    IF e is an addition THEN
      RETURN lit((u+v) mod 256)
    ELSE
      RETURN lit((u * v) mod 256)
    END IF
  END IF
  RETURN a node with e's operator and children p, q
END FUNCTION

