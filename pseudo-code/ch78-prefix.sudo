# slug: ch78-prefix
# source: chapters/ch78.tex:54
# label: alg:ch78-prefix
# pseudocode source: chapters/ch78.tex:57
# caption: Construct the prefix function of a nonempty pattern.

REQUIRE pattern p of length m>0
ENSURE longest proper-border lengths pi[0:m]
initialize pi to zero; j <- 0
FOR i=1 to m-1 DO
  WHILE j>0 and p[i] != p[j] DO
    j <- pi[j-1]
  END WHILE
  IF p[i]=p[j] THEN
    j <- j+1
  END IF
  pi[i] <- j
END FOR

