# slug: app-d-subst
# source: appendices/appendix-d.tex:22
# label: alg:app-d-subst
# pseudocode source: appendices/appendix-d.tex:25
# caption: Capture-avoiding substitution of N for x in M.

REQUIRE terms M and N, variable x; bound names in M distinct from free names of N after renaming
ENSURE term M[x := N] with no captured free variable of N
FUNCTION Subst(M, x, N)
  IF M is a variable y THEN
    IF y = x THEN RETURN N
    ELSE RETURN y
    END IF
  ELSE IF M is app(P, Q) THEN
    RETURN app(Subst(P, x, N), Subst(Q, x, N))
  ELSE IF M is lam(y, P) with y = x THEN RETURN M
  ELSE // rename y when y occurs free in N
    pick fresh z and RETURN lam(z, Subst(P[y := z], x, N))
  END IF
END FUNCTION

