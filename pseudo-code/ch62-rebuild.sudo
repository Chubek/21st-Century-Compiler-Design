# slug: ch62-rebuild
# source: chapters/ch62.tex:75
# label: alg:ch62-rebuild
# pseudocode source: chapters/ch62.tex:78
# caption: Rebuild congruence after class unions.

REQUIRE finite e-node list, union-find class relation
ENSURE equal canonical e-nodes have the same owning class
REPEAT
  clear memo table; changed <- false
  FORALL e-nodes n with owner c DO
    replace each child ID in n by its current representative
    IF the canonical node already has owner d in the memo table THEN
      union c and d; record whether a new merge occurred
    ELSE
      insert the canonical node with owner c
    END IF
  END FOR
UNTIL no new merge occurred
canonicalize memo-table owners

