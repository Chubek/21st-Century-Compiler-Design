# slug: ch33-mark
# source: chapters/ch33.tex:89 (approximate line of \begin{algorithm})
# caption: Tri-color marking with an explicit worklist
# label: alg:ch33-mark
# require: valid non-null object roots R, stable heap H with reference lists; mutator stopped
# ensure: every reachable object is marked black
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE valid non-null object roots R, stable heap H with reference lists; mutator stopped
ENSURE every reachable object is marked black
color all objects white
W <- {}
FORALL r in R DO
  IF r is white THEN
    color r gray and add r to W
  END IF
END FOR
WHILE W != {} DO
  remove some g from W
  FORALL valid non-null object references c in g DO
    IF c is white THEN
      color c gray and add c to W
    END IF
  END FOR
  color g black
END WHILE
RETURN all black objects

