# Generated by support/export-artifacts.py; do not edit.
# slug: ch43-close
# source: chapters/ch43.tex:58
# label: alg:ch43-close
# pseudocode source: chapters/ch43.tex:61
# caption: Close an integer DBM and detect inconsistency.

REQUIRE m * m DBM M, entries in Z UNION {+infinity}
REQUIRE index 0 denotes zero; addition uses exact integer arithmetic
ENSURE canonical bounds for the same solutions, or BOTTOM if none exist
D <- a copy of M
FOR i=0,...,m-1 DO
  D_{ii} <- min(D_{ii},0)
END FOR
FOR k=0,...,m-1 DO
  FOR i=0,...,m-1 DO
    FOR j=0,...,m-1 DO
      IF D_{ik} != +infinity and D_{kj} != +infinity THEN
        D_{ij} <- min(D_{ij},D_{ik}+D_{kj})
      END IF
    END FOR
  END FOR
  IF some D_{ii}<0 THEN
    RETURN BOTTOM
  END IF
END FOR
RETURN D

