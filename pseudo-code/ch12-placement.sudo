# slug: ch12-placement
# source: chapters/ch12.tex:68
# label: alg:ch12-placement
# pseudocode source: chapters/ch12.tex:70
# caption: Minimal phi placement by iterated dominance frontiers

REQUIRE CFG G, dominator tree with DF(n) per node, set Def(v) of blocks defining each v
ENSURE one phi for v at each join in the iterated frontier of Def(v)
FORALL variable v defined anywhere in G DO
  Work <- Def(v)
  Placed <- {}
  WHILE Work != {} DO
    remove some n from Work
    FORALL j in DF(n) DO
      IF j not in Placed for v THEN
        insert v_j <- phi(...) at the head of j
        Placed <- Placed UNION {j}
        IF j not in Def(v) originally THEN
          add j to Work
        END IF
      END IF
    END FOR
  END WHILE
END FOR

