# slug: ch38-pipeline-run
# source: chapters/ch38.tex:80
# label: alg:ch38-pipeline-run
# pseudocode source: chapters/ch38.tex:82
# caption: Contract-checked pipeline driver with fact versions

REQUIRE pass list P_1 ... P_k, input program T, fact store S
ENSURE output passing the enabled checks, or the first detected contract violation
FORALL i from 1 to k DO
  check entry contract of P_i on T and S
  IF entry check fails THEN
    RETURN violation at entry of P_i
  END IF
  run P_i on T and update S // drop destroyed facts
  check exit contract of P_i on T and S
  IF exit check fails THEN
    RETURN violation at exit of P_i
  END IF
END FOR
RETURN T with build record

