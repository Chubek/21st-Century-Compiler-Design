# slug: ch45-monitor
# source: chapters/ch45.tex:176
# label: alg:ch45-monitor
# pseudocode source: chapters/ch45.tex:179
# caption: Turn a finite-history deoptimization obligation into reachability.

REQUIRE total finite model (S,I,R), edge events e, monitor Q={C,P,B} and delta
ENSURE reachable product states and edges, initialized before the first event
D <- {(s,C) | s in I}; W <- queue containing D; R_P <- {}
WHILE W != {} DO
  remove (s,q) from W
  FORALL t in Succ(s) DO
    q' <- delta(q,e(s,t)); R_P <- R_P UNION {((s,q),(t,q'))}
    IF (t,q') not in D THEN
      add (t,q') to D and W
    END IF
  END FOR
END WHILE
RETURN D,R_P, with bad states {(s,B) in D}

