# slug: ch43-widen-loop
# source: chapters/ch43.tex:254
# label: alg:ch43-widen-loop
# pseudocode source: chapters/ch43.tex:257
# caption: Solve one DBM loop header with raw widening and bounded replay.

REQUIRE nonempty closed entry E, monotone sound header map H
REQUIRE H includes E and returns a closed DBM; replay budget q >= 0
ENSURE closed header invariant D with H(D) <=[lattice] D
W <- E
LOOP
  C <- H(Close(W))
  IF C_{ij} <= W_{ij} for every i,j THEN
    BREAK
  END IF
  FORALL pairs (i,j) DO
    IF C_{ij}>W_{ij} THEN
      W_{ij} <- +infinity
    END IF
  END FOR
END LOOP
D <- Close(W)
FOR t=1,...,q DO
  D <- H(D)
END FOR
RETURN D

