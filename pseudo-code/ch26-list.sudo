# slug: ch26-list
# source: chapters/ch26.tex:93 (approximate line of \begin{algorithm})
# caption: Forward list scheduling for one region
# label: alg:ch26-list
# require: complete dependence DAG D, resource table R, edge delays, individually schedulable operations
# ensure: legal schedule S for the region
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE complete dependence DAG D, resource table R, edge delays, individually schedulable operations
ENSURE legal schedule S for the region
compute priority H(n) as the critical-path height of n
cycle <- 0, Ready <- nodes with no predecessors
WHILE unscheduled nodes remain DO
  release each unscheduled node once all predecessors are placed and their edge delays have elapsed
  select the highest H(n) in Ready that fits R at cycle
  IF such n exists THEN
    place n at cycle and reserve its resources in R
    remove n from Ready
  ELSE
    advance cycle by one idle step
  END IF
END WHILE
emit S in cycle order with exact slot assignments

