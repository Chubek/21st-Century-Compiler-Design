# slug: ch49-subsets
# source: chapters/ch49.tex:134
# label: alg:ch49-subsets
# pseudocode source: chapters/ch49.tex:137
# caption: Intern reachable NFA subsets as DFA states.

REQUIRE NFA start s, alphabet classes Sigma, accepting states with token priorities
ENSURE DFA with the same prefix languages and winning output at every state
X_0 <- E({s}); intern X_0; queue X_0
WHILE an unprocessed subset X remains DO
  remove X from the queue
  output of X <- highest-priority accepting token in X, or none
  FORALL alphabet classes a in Sigma DO
    Y <- E( UNION _{q in X}delta(q,a))
    IF Y has not been interned THEN
      intern Y and queue it
    END IF
    set transition (X,a) to the interned identifier of Y
  END FOR
END WHILE

