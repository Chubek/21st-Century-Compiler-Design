# slug: ch37-reduce
# source: chapters/ch37.tex:85 (approximate line of \begin{algorithm})
# caption: Greedy single-fragment test-case reduction
# label: alg:ch37-reduce
# require: failing test T, finite removable fragments, deterministic same-failure predicate F
# ensure: T still fails and no permitted valid single-fragment removal preserves that failure
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE failing test T, finite removable fragments, deterministic same-failure predicate F
ENSURE T still fails and no permitted valid single-fragment removal preserves that failure
confirm F(T); abort reduction if the original signature is absent
REPEAT
  changed <- false
  FORALL i from 1 to n DO
    T' <- T with f[i] removed
    IF T' is well-formed and F(T') holds THEN
      T <- T'
      changed <- true; refresh fragment numbering and restart the scan
      BREAK
    END IF
  END FOR
UNTIL not changed
RETURN T

