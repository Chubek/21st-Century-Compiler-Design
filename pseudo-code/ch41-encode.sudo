# slug: ch41-encode
# source: chapters/ch41.tex:113
# label: alg:ch41-encode
# pseudocode source: chapters/ch41.tex:116
# caption: Encode a Boolean formula DAG as a satisfiability-equivalent CNF.

REQUIRE Root r of an acyclic DAG with literal leaves and unary NOT or binary AND/OR nodes
ENSURE Clauses satisfiable exactly when the formula rooted at r is satisfiable
K <- empty clause list
FORALL nodes v in a children-before-parent topological order DO
  IF v is a literal THEN
    L[v] <- that literal
  ELSE
    z <- a fresh atom; L[v] <- z
    IF v is NOT with child a THEN
      Append (NOT z OR NOT L[a]) and (z OR L[a]) to K
    ELSE IF v is AND with children a,b THEN
      Append (NOT z OR L[a]) and (NOT z OR L[b]) to K
      Append (z OR NOT L[a] OR NOT L[b]) to K
    ELSE // OR with children a,b
      Append (z OR NOT L[a]) and (z OR NOT L[b]) to K
      Append (NOT z OR L[a] OR L[b]) to K
    END IF
  END IF
END FOR
Append unit clause (L[r]) to K
RETURN K

