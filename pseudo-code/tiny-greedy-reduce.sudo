# slug: tiny-greedy-reduce
# source: chapters/ch01/fault-lab.tex:136 (approximate line of \begin{algorithm})
# caption: Reduce a failing tree using a fixed set of local replacements.
# label: alg:tiny-greedy-reduce
# require: A valid finite tree e with M(e, a); fixed input a
# ensure: Retain M(e, a); no permitted single improving replacement remains
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE A valid finite tree e with M(e, a); fixed input a
ENSURE Retain M(e, a); no permitted single improving replacement remains
REPEAT
  changed <- false
  FORALL sites in preorder, trying child replacements then literals 0, 1 DO
    form a candidate tree e'
    IF (N(e'), W(e'))<(N(e), W(e)) and M(e', a) THEN
      e <- e'
      changed <- true
      BREAK
    END IF
  END FOR
UNTIL not changed

