# slug: ch65-quicken
# source: chapters/ch65.tex:27
# label: alg:ch65-quicken
# pseudocode source: chapters/ch65.tex:30
# caption: Execute a guarded addition site with one-way generalization.

REQUIRE operands a,b, site state in cold, integer, or generic
ENSURE the language's integer/string addition result or type error
ints <- both operands have exactly the integer type
IF the site is cold THEN
  select integer state if ints, otherwise generic
END IF
IF the site is integer and ints is false THEN
  increment miss count; replace the site state with generic
END IF
IF ints THEN
  RETURN integer addition
END IF
IF both operands have exactly the string type THEN
  RETURN string concatenation
END IF
RETURN type error

