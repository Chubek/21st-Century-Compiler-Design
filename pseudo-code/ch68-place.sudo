# slug: ch68-place
# source: chapters/ch68.tex:160
# label: alg:ch68-place
# pseudocode source: chapters/ch68.tex:163
# caption: Find the exact optimum of the small unit-slot placement model.

REQUIRE n equal-sized artifacts, symmetric nonnegative pair weights
ENSURE a permutation minimizing the stated weighted-distance objective
best <- infinity; order <- none
FORALL permutations p of the artifact IDs DO
  construct the position of each artifact in p
  cost <- SUM_{i<j}w_{ij}|p^{-1}(i)-p^{-1}(j)|
  IF cost<best THEN
    best <- cost; order <- p
  END IF
END FOR
RETURN best,order

