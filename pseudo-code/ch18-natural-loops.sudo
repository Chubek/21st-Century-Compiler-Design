# slug: ch18-natural-loops
# source: chapters/ch18.tex:55 (approximate line of \begin{algorithm})
# caption: Natural loop discovery from back edges
# label: alg:ch18-natural-loops
# require: entry-reachable CFG, dominator sets dom(B) for every block B
# ensure: the set of natural loops, each as a header plus member blocks
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE entry-reachable CFG, dominator sets dom(B) for every block B
ENSURE the set of natural loops, each as a header plus member blocks
Loops <- empty set
FOR each edge u -> h in the CFG DO
  IF h in dom(u) THEN
    Body <- {h, u}
    Work <- {u} - {h}
    WHILE Work != {} DO
      remove some x from Work
      FOR each predecessor p in Pred(x) DO
        IF p not in Body THEN
          add p to Body and to Work
        END IF
      END FOR
    END WHILE
    add (h, Body) to Loops
  END IF
END FOR

