# slug: ch62-extract
# source: chapters/ch62.tex:144
# label: alg:ch62-extract
# pseudocode source: chapters/ch62.tex:147
# caption: Extract a minimum-cost finite tree from a fixed e-graph.

REQUIRE rebuilt graph, positive additive node costs, root class r
ENSURE minimum finite tree cost for r, or no finite witness
initialize every class cost to infinity
REPEAT
  changed <- false
  FORALL nodes whose child classes have finite costs DO
    candidate <- node cost plus the sum of child costs
    IF candidate is smaller than the owning class cost THEN
      store the candidate cost and its finite witness tree
      changed <- true
    END IF
  END FOR
UNTIL no cost changes
RETURN the root's cost and witness, if finite

