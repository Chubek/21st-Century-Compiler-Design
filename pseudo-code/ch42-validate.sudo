# slug: ch42-validate
# source: chapters/ch42.tex:166
# label: alg:ch42-validate
# pseudocode source: chapters/ch42.tex:169
# caption: Validate a proposed invariant on an immutable IR revision.

REQUIRE revision r, graph G, boundary covers b, candidate A
REQUIRE sound edge transfers and a sound inclusion test
ENSURE accept only if A covers all executions from b in r
IF A.revision != r THEN
  RETURN reject
END IF
FORALL points B in G DO
  IF b_BNOT <=[lattice] A_B THEN
    RETURN reject
  END IF
END FOR
FORALL edges e=(P,B) in G DO
  t <- F_e^#(A_P)
  IF tNOT <=[lattice] A_B THEN
    RETURN reject
  END IF
END FOR
RETURN accept

