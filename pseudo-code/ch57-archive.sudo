# label: alg:ch57-archive
# pseudocode source: chapters/ch57.tex:185
# caption: Search an archive group to member-extraction closure.

REQUIRE ordered archives, current definitions and unresolved strong references
ENSURE no unselected member in the group satisfies an outstanding extraction demand
REPEAT
  changed <- false
  FORALL archives and their members in the declared search order DO
    IF an unselected member defines a demanded name THEN
      mark the member selected before processing its contents
      incorporate its definitions using the resolution rules
      incorporate its undefined references and recompute demands
      changed <- true
    END IF
  END FOR
UNTIL no member was selected

