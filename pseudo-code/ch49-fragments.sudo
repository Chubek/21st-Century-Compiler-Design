# label: alg:ch49-fragments
# pseudocode source: chapters/ch49.tex:64
# caption: Compile a regular expression into a fragment with patchable exits.

REQUIRE expression tree r over symbols, epsilon, union, concatenation, and star
ENSURE fragment with entry and exit slots, preserving the expression language
FUNCTION Compile(r)
  IF r is symbol a or epsilon THEN
    create one consuming or epsilon state with an unpatched exit
    RETURN its entry and its one exit slot
  ELSE IF r=u * v THEN
    U <- Compile(u); V <- Compile(v)
    patch every exit of U to the entry of V
    RETURN entry of U, exits of V
  ELSE IF r=u | v THEN
    compile U,V; create a split with epsilon edges to both entries
    RETURN split entry, concatenation of the two exit lists
  ELSE
    U <- Compile(u) where r=u^*
    create split s with one edge to U and one unpatched edge
    patch every exit of U to s
    RETURN s, its remaining exit slot
  END IF
END FUNCTION
patch the completed fragment's exits to a new accepting state

