# slug: ch03-scan
# source: chapters/ch03.tex:115 (approximate line of \begin{algorithm})
# caption: Maximal-munch scanning of Mini source text.
# label: alg:ch03-scan
# require: source characters S of length L
# ensure: token list T with kinds, lexemes, and positions, or a lexical error
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE source characters S of length L
ENSURE token list T with kinds, lexemes, and positions, or a lexical error
FUNCTION Scan(S)
  set position P to 0 and token list T to empty
  WHILE P is below L DO
    IF the character at P is blank or begins a comment THEN
      advance past whitespace or the complete comment
    ELSE IF the character at P starts a word THEN
      gather the longest letter-and-digit run
      classify it as a keyword or an identifier and append the token
    ELSE IF the character at P is a digit THEN
      gather the longest digit run and append a number token
    ELSE IF the character at P starts an operator THEN
      take the longest valid operator and append it
    ELSE
      RETURN a lexical error naming the character and its position
    END IF
  END WHILE
  append the end-of-input token and RETURN T
END FUNCTION

