# label: alg:ch05-check
# pseudocode source: chapters/ch05.tex:86
# caption: Single-pass name resolution and type checking for Mini.

REQUIRE syntax tree node N, scope stack S
ENSURE kind of N with all names resolved, or a diagnostic
FUNCTION Check(N, S)
  IF N is a number THEN
    RETURN integer
  ELSE IF N is a variable THEN
    resolve it in S or report an undefined name; RETURN its kind
  ELSE IF N is a let binding THEN
    check the value, push the name with its kind, check the body, then pop
  ELSE IF N is an assignment THEN
    resolve the target; check that the value has its declared kind; RETURN unit
  ELSE IF N is an arithmetic node THEN
    check both children, require integers, and RETURN integer
  ELSE IF N is a comparison THEN
    check both children, require integers, and RETURN boolean
  ELSE IF N is a conditional or loop THEN
    require a boolean test and check the branches or body
  ELSE
    check each child in order and combine the resulting kinds
  END IF
END FUNCTION

