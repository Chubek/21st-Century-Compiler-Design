# slug: ch21-load-elim
# source: chapters/ch21.tex:47 (approximate line of \begin{algorithm})
# caption: Redundant load elimination with alias kills
# label: alg:ch21-load-elim
# require: reachable SSA CFG, ordinary nonvolatile non-atomic loads, sound effect and alias information
# ensure: replace loads only with a dominating, unchanged value of matching address, type, and width
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE reachable SSA CFG, ordinary nonvolatile non-atomic loads, sound effect and alias information
ENSURE replace loads only with a dominating, unchanged value of matching address, type, and width
Avail(B) <- empty set for every block B
changed <- true
WHILE changed DO
  changed <- false
  FOR each block B DO
    In <- BIG-INTERSECT[P in Pred(B)] Avail(P); use the empty set at entry
    scan B in order; kill clobbered facts and add each original load's typed address-value fact
    New <- facts remaining at the end of the scan
    IF New != Avail(B) THEN
      Avail(B) <- New; changed <- true
    END IF
  END FOR
END WHILE
replay each block from its converged input, recording facts before each instruction
FOR each load l of address a in block B DO
  IF a matching fact before l names a value dominating l THEN
    replace l with a copy of the recorded value
  END IF
END FOR

