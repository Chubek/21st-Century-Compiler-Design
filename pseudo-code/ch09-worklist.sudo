# slug: ch09-worklist
# source: chapters/ch09.tex:142 (approximate line of \begin{algorithm})
# caption: Worklist iterative dataflow for gen-kill problems
# label: alg:ch09-worklist
# require: entry-reachable CFG G, gen-kill summaries, direction d, join MEET, boundary facts
# ensure: In[B] and Out[B] satisfy the dataflow equations for every B
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE entry-reachable CFG G, gen-kill summaries, direction d, join MEET, boundary facts
ENSURE In[B] and Out[B] satisfy the dataflow equations for every B
initialize In[B] and Out[B] to the identity of MEET for all B
set the boundary block to its fixed boundary value
W <- all blocks in G
WHILE W != {} DO
  remove some B from W
  IF d is forward THEN
    newIn <- MEET[P in Pred(B)] Out[P], or boundary if B is entry
    newOut <- Gen[B] UNION (newIn - Kill[B])
    IF newOut != Out[B] or newIn != In[B] THEN
      In[B] <- newIn
      Out[B] <- newOut
      add Succ(B) to W
    END IF
  ELSE
    newOut <- MEET[S in Succ(B)] In[S], or boundary if B is exit
    newIn <- Gen[B] UNION (newOut - Kill[B])
    IF newIn != In[B] or newOut != Out[B] THEN
      In[B] <- newIn
      Out[B] <- newOut
      add Pred(B) to W
    END IF
  END IF
END WHILE

