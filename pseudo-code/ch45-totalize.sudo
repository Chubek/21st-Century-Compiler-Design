# slug: ch45-totalize
# source: chapters/ch45.tex:97
# label: alg:ch45-totalize
# pseudocode source: chapters/ch45.tex:100
# caption: Totalize a finite model while retaining terminal outcomes.

REQUIRE raw finite model (S,I,R_0,AP,L), adjacency lists, terminal classification
ENSURE total R and labels distinguishing halt, error, and deadlock
R <- R_0
FORALL s in S DO
  IF Succ_{R_0}(s)={} THEN
    IF s is classified as normal termination THEN
      L(s) <- L(s) UNION {halt}
    ELSE IF s is classified as explicit failure THEN
      L(s) <- L(s) UNION {error}
    ELSE
      L(s) <- L(s) UNION {deadlock,error}
    END IF
    R <- R UNION {(s,s)}
  END IF
END FOR
RETURN (S,I,R,AP UNION {halt,error,deadlock},L)

