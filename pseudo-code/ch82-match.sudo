# pseudocode source: chapters/ch82.tex:83
# caption: Match a finite first-order pattern against one fixed subject.

REQUIRE well-formed pattern and subject; separate pattern-variable namespace
ENSURE consistent matcher substitution or failure
initialize pair worklist and empty bindings
WHILE a pair (p,s) remains DO
  IF p is a pattern variable THEN
    bind it to s if unbound; otherwise require equality with its binding
  ELSE
    require matching root symbol and arity
    enqueue corresponding children
  END IF
END WHILE
return bindings

