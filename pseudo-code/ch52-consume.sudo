# label: alg:ch52-consume
# pseudocode source: chapters/ch52.tex:280
# caption: Consume a generated parser result without confusing failure categories.

REQUIRE generated parser, source buffer, explicit resource policy
ENSURE result storage released and only successful values consumed
r <- Parse(buffer,length,limits)
IF r.status=OK THEN
  consume or copy r.value, permitting a null semantic value
ELSE IF r.status=SYNTAX THEN
  report failed recognition at the recorded byte offset
ELSE
  report the resource or API failure separately
END IF
release all result-owned allocations

