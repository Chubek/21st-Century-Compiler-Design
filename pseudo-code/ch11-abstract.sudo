# slug: ch11-abstract
# source: chapters/ch11.tex:86 (approximate line of \begin{algorithm})
# caption: Abstract interpretation over a CFG with widening at loop heads
# label: alg:ch11-abstract
# require: reachable CFG with predecessor-free entry, monotone sound edge transfers F[P, B], widening widen, widening points meeting every cycle
# ensure: over-approximation X[B] of all reachable concrete states at each B
# keywords: INPUT/OUTPUT/REQUIRE/ENSURE/FOR/FORALL/WHILE/IF/ELSE/RETURN

REQUIRE reachable CFG with predecessor-free entry, monotone sound edge transfers F[P, B], widening widen, widening points meeting every cycle
ENSURE over-approximation X[B] of all reachable concrete states at each B
X[B] <- BOT for every block B
X[entry] <- abstraction of the known input description
W <- all blocks in G
WHILE W != {} DO
  remove some B from W
  in <- JOIN[P in Pred(B)] F[P, B](X[P]), or entry abstraction at entry
  new <- X[B] JOIN in
  IF B is a widening point and new NOT [= X[B] THEN
    new <- X[B] widen new
  END IF
  IF new != X[B] THEN
    X[B] <- new
    add Succ(B) to W
  END IF
END WHILE

