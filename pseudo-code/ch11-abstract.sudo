# slug: ch11-abstract
# source: chapters/ch11.tex:87
# label: alg:ch11-abstract
# pseudocode source: chapters/ch11.tex:89
# caption: Abstract interpretation over a CFG with widening at loop heads

REQUIRE reachable CFG with predecessor-free entry, monotone sound edge transfers F_{P,B}, widening NABLA, widening points meeting every cycle
ENSURE over-approximation X[B] of all reachable concrete states at each B
X[B] <- BOTTOM for every block B
X[entry] <- abstraction of the known input description
W <- all blocks in G
WHILE W != {} DO
  remove some B from W
  in <- JOIN_{P in Pred(B)} F_{P,B}(X[P]), or entry abstraction at entry
  new <- X[B] JOIN in
  IF B is a widening point and new NOT <=[lattice] X[B] THEN
    new <- X[B] NABLA new
  END IF
  IF new != X[B] THEN
    X[B] <- new
    add Succ(B) to W
  END IF
END WHILE

